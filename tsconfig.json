{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],

		"module": "CommonJS",

		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,

		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,

		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,

		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"types": ["node"],

		"outDir": "./dist",
		"rootDir": ".",
		"sourceMap": true,

		"jsx": "react"
	}
}
