generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @default(uuid()) @id

  email String @unique
  username String @unique
  hashPassword String @map("password")

  nickname String?
  bio String?
  avatar String?

  sessionIDs String[]

  isVerified Boolean @default(false) @map("is_verified")
  isEmailVerified Boolean @default(false) @map("is_email_verified")

  tokens Token[]

  isTotpEnabled Boolean @default(false) @map("is_totp_enabled")
  encryptedTotpSecret String? @map("totp_secret")
  encryptedTotpPendingSecret String? @map("totp_pending_secret")
  hashRecoveryCodes String[] @map("recovery_codes")

  isDeactivated Boolean @default(false) @map("is_deactivated")
  deactivatedAt DateTime? @map("deactivated_at")
  hashDeactivationCode String? @map("deactivation_code")
  deactivationCodeExpiresAt DateTime? @map("deactivation_code_expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user")
}

model Token {
  id String @default(uuid()) @id

  hashToken String @unique @map("token")
  type TokenType
  expires DateTime

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("token")
}

enum TokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  AUTH_TELEGRAM

  @@map("token_type")  
}