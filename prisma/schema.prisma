generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @default(uuid()) @id

  email String @unique
  username String @unique
  password String

  nickname String?
  bio String?
  avatar String?

  sessionIDs String[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user")
}
